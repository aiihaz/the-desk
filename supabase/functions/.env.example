# Copy to .env for 'supabase functions serve'. See README for where each value comes from.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_CONNECTION_ID=
SARVAM_WEBHOOK_TOKEN=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPER_API_KEY=

# Add iMessage to the existing Supabase project. Routing follows each stored user.
LINQ_API_TOKEN=
LINQ_WEBHOOK_SECRET=
# Admin phone numbers, international digits without + (legacy internal name).
DESK_ADMIN_LINQ_IDS=

# Linq-only echo test; never changes WhatsApp DESK_ECHO.
DESK_LINQ_ECHO=0

# Owner-only calls are paused until explicitly resumed by the user.
DESK_CALLS_PAUSED=1

# Share the active native iMessage contact card after an outbound reply, at most daily.
LINQ_SHARE_CONTACT_CARD=1
# Local browser bench (deno task dev). Never enable real calls by accident.
DEV_REAL_CALLS=0
# Your consenting test-business phone, E.164. Keep the real value only in .env.
DEV_TEST_PHONE=
# Public Sarvam callback that writes to the SAME database as the local bench.
# Local mode also polls analytics to recover terminal results.
SARVAM_WEBHOOK_URL=
# Optional cloud secret alias; falls back to OPENAI_API_KEY.
DESK_OPENAI_API_KEY=
