{
  "tasks": {
    "test": "deno test --allow-read=fixtures,supabase supabase/functions",
    "check": "deno fmt --check && deno lint && deno check supabase/functions/*/index.ts dev/server.ts dev/evals.ts dev/jev_eval.ts dev/report_eval.ts dev/caller_check.ts",
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run=supabase dev/server.ts",
    "eval": "deno run --allow-net --allow-env dev/evals.ts",
    "jev": "deno run --allow-net --allow-env --allow-read dev/jev_eval.ts",
    "report-eval": "deno run --allow-net --allow-env --allow-read dev/report_eval.ts",
    "caller-check": "deno run --allow-read dev/caller_check.ts",
    "test:auth": "deno run --allow-run --allow-read --allow-net=127.0.0.1 scripts/test_internal_auth.ts"
  },
  "fmt": {
    "lineWidth": 110,
    "include": [
      "supabase/functions",
      "dev/server.ts",
      "dev/evals.ts",
      "dev/jev_eval.ts",
      "dev/report_eval.ts",
      "dev/caller_check.ts"
    ]
  },
  "lint": {
    "include": [
      "supabase/functions",
      "dev"
    ],
    "rules": {
      "exclude": [
        "require-await",
        "no-import-prefix"
      ]
    }
  }
}
